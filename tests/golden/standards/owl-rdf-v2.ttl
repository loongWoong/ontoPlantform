@prefix onto: <https://ontoplatform.local/ws/ws-1/onto/traffic/v2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ontoplatform.local/ws/ws-1/onto/traffic/v2> rdf:type owl:Ontology .
<https://ontoplatform.local/ws/ws-1/onto/traffic/v2> rdfs:label "traffic"^^xsd:string .
<https://ontoplatform.local/ws/ws-1/onto/traffic/v2> owl:versionIRI <https://ontoplatform.local/ws/ws-1/onto/traffic/v2/version/2> .
<https://ontoplatform.local/ws/ws-1/onto/traffic/v2> owl:versionInfo "v2 fingerprint:abc123"^^xsd:string .
onto:TollStation rdf:type owl:Class .
onto:TollStation rdfs:comment "收费站"@zh .
onto:TollStation rdfs:label "TollStation"^^xsd:string .
onto:Vehicle rdf:type owl:Class .
onto:Vehicle rdfs:comment "车辆"@zh .
onto:Vehicle rdfs:label "Vehicle"^^xsd:string .
onto:Vehicle.active rdf:type owl:DatatypeProperty .
onto:Vehicle.active rdfs:domain onto:Vehicle .
onto:Vehicle.active rdfs:range xsd:boolean .
onto:Vehicle.balance rdf:type owl:DatatypeProperty .
onto:Vehicle.balance rdfs:domain onto:Vehicle .
onto:Vehicle.balance rdfs:range xsd:decimal .
onto:Vehicle.plate rdf:type owl:DatatypeProperty .
onto:Vehicle.plate rdfs:comment "车牌号码，例如 \"鲁A12345\"\n第二行\\反斜杠"@zh .
onto:Vehicle.plate rdfs:domain onto:Vehicle .
onto:Vehicle.plate rdfs:range xsd:string .
onto:Vehicle.since rdf:type owl:DatatypeProperty .
onto:Vehicle.since rdfs:domain onto:Vehicle .
onto:Vehicle.since rdfs:range xsd:dateTime .
onto:passed_by rdf:type owl:ObjectProperty .
onto:passed_by rdfs:domain onto:TollStation .
onto:passed_by rdfs:range onto:Vehicle .
onto:passed_by owl:inverseOf onto:passes .
onto:passes rdf:type owl:ObjectProperty .
onto:passes rdfs:domain onto:Vehicle .
onto:passes rdfs:range onto:TollStation .
onto:passes owl:inverseOf onto:passed_by .
